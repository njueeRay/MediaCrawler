# ==================== 基础配置 ====================
# 项目根目录（默认自动推断，可不填）
# PROJECT_ROOT="/path/to/MediaCrawler"

# 是否执行爬虫步骤：1=执行，0=跳过
RUN_CRAWL=1

# 是否执行“同步到表1”步骤：1=执行，0=跳过
RUN_SYNC_TABLE1=1

# 是否执行“读表1并解析JSON上传表2”步骤：1=执行，0=跳过
RUN_PARSE_TO_TABLE2=1

# ==================== 爬虫配置（微信 creator 模式） ====================
# 登录方式: cookie / qrcode / phone
LOGIN_TYPE="cookie"

# 存储方式：csv / sqlite / db(mysql) / postgres
# - csv: 步骤2从 TABLE1_SOURCE_CSV 或 data/wechat/csv/*_contents.csv 同步
# - sqlite/db/postgres: 步骤2直接走“DB -> 飞书表1”
SAVE_DATA_OPTION="csv"

# 逗号分隔的 fakeid 列表；留空则使用 config/wechat_config.py 或环境中的 WECHAT_CREATOR_LIST_FILE
CREATOR_IDS=""

# 日期范围（YYYY-MM-DD），留空表示不限制
WECHAT_ARTICLE_DATE_START="2026-01-01"
WECHAT_ARTICLE_DATE_END="2026-12-31"

# 最大文章数（每个公众号）
WECHAT_MAX_ARTICLES_PER_CREATOR=20

# 可选：爬取标签（写入 source_keyword）
WECHAT_CRAWL_TAG="订阅自动化任务"

# ==================== 飞书连接（会覆盖 .env） ====================
# 若不填，python 脚本会自动从项目 .env 加载（推荐：凭证统一管理在 .env）
# FEISHU_APP_ID=""
# FEISHU_APP_SECRET=""
# FEISHU_APP_TOKEN=""

# ==================== 表1：原始文章同步 ====================
# 表1（文章原始数据） table_id
TABLE1_ID=""

# 批量写入大小
TABLE1_BATCH_SIZE=50

# 表1上传范围（按源数据顺序，1-based，包含边界；0 表示不限制）
TABLE1_RANGE_START=0
TABLE1_RANGE_END=0

# 可选：指定内容 CSV 文件；留空则自动找 data/wechat/csv 最新 *_contents.csv
TABLE1_SOURCE_CSV=""

# ==================== 表1 -> 解析导出 CSV ====================
# 导出路径
TABLE1_EXPORT_CSV="data/wechat/csv/table1_export_for_parse.csv"

# 是否将“步骤3读取到的表1结果”同时写入数据库快照表 feishu_record_snapshot
# 1=写入，0=不写
TABLE1_EXPORT_TO_DB=0

# 当 TABLE1_EXPORT_TO_DB=1 时使用的数据库类型
# 支持：sqlite / mysql / db / postgres
# 默认跟随 SAVE_DATA_OPTION
TABLE1_EXPORT_DB_TYPE="${SAVE_DATA_OPTION}"

# 当 TABLE1_EXPORT_TO_DB=1 时写入的批次名（dataset_name）
TABLE1_EXPORT_DB_DATASET="wechat_table1_readback"

# 从表1读取的字段（逗号分隔）
# 例如: 文章ID,标题,AI结构化结果,AI标签JSON
TABLE1_SELECT_FIELDS="文章ID,标题"

# 可选：直接按视图读取（推荐）
# 设置后可替代手工过滤（只读取该视图可见记录）
TABLE1_VIEW_ID=""

# 可选过滤（留空则不过滤）
TABLE1_FILTER_FIELD=""
TABLE1_FILTER_OPERATOR=""
TABLE1_FILTER_VALUES=""
TABLE1_FILTER_CONJUNCTION="or"

# 可选：多条件过滤（JSON 数组）
# 设置后优先级高于上面的单条件过滤参数
# 示例：
# TABLE1_FILTERS_JSON='[{"field":"来源关键词","operator":"contains","values":["黑客松"]},{"field":"类型","operator":"is","values":["普通图文"]}]'
TABLE1_FILTERS_JSON=""
TABLE1_FILTERS_CONJUNCTION="and"

# ==================== 表2：JSON 解析后上传 ====================
# 表2 table_id（解析结果写入这个表）
TABLE2_ID=""

# 需要解析为 JSON 的列（逗号分隔，必须出现在 TABLE1_SELECT_FIELDS 里）
JSON_COLUMNS=""

# 保留的普通列（逗号分隔），为空则自动保留所有非 JSON 列
JSON_KEEP_COLUMNS="文章ID,标题"

# 表2默认主字段（可选，空则自动首字段）
TABLE2_PRIMARY=""

# JSON 字段扁平化分隔符
JSON_FLATTEN_SEP="."

# 表2同步批次
TABLE2_BATCH_SIZE=50

# 表2上传范围（对解析后记录生效，1-based，包含边界；0 表示不限制）
TABLE2_RANGE_START=0
TABLE2_RANGE_END=0
