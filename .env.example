# ============================================================
#  MediaCrawler 环境变量配置
#  复制本文件为 .env 并根据需要修改
#  也可通过 WebUI「配置管理」页面在线编辑
# ============================================================

# ==================== 爬虫通用配置 ====================

# 目标平台: xhs | dy | ks | bili | wb | tieba | zhihu | wechat
PLATFORM="xhs"

# 搜索关键词，多个用英文逗号分隔
KEYWORDS="Python学习"

# 登录方式: qrcode | phone | cookie
LOGIN_TYPE="qrcode"

# Cookie 登录模式使用 (LOGIN_TYPE=cookie 时填写)
COOKIES=""

# 采集方式: search | detail | creator
CRAWLER_TYPE="search"

# 单次采集最大笔记/视频数量
CRAWLER_MAX_NOTES_COUNT=100

# 并发爬虫数量
MAX_CONCURRENCY_NUM=1

# 每次请求间的休眠时间 (秒)
CRAWLER_MAX_SLEEP_SEC=2

# 爬取起始页码
START_PAGE=1

# ==================== 评论 & 媒体采集 ====================

# 是否下载图片/视频资源
ENABLE_GET_MEIDAS=true

# 是否开启评论采集
ENABLE_GET_COMMENTS=false

# 单帖最大评论采集数
CRAWLER_MAX_COMMENTS_COUNT_SINGLENOTES=10

# 是否爬取二级评论
ENABLE_GET_SUB_COMMENTS=false

# ==================== IP 代理 ====================

# 是否启用 IP 代理
ENABLE_IP_PROXY=false

# 代理 IP 池数量
IP_PROXY_POOL_COUNT=2

# 代理供应商: kuaidaili | wandouhttp
IP_PROXY_PROVIDER_NAME="kuaidaili"

# ---- 快代理 ----
# KDL_SECERT_ID=""
# KDL_SIGNATURE=""
# KDL_USER_NAME=""
# KDL_USER_PWD=""

# ---- 豌豆 HTTP ----
# WANDOU_APP_KEY=""

# ---- 极速 HTTP ----
# jisu_key=""
# jisu_crypto=""

# ==================== 浏览器配置 ====================

# 无头浏览器模式 (不显示浏览器窗口)
HEADLESS=false

# 是否保存登录状态 (下次启动跳过登录)
SAVE_LOGIN_STATE=true

# 是否启用 CDP 模式 (使用用户现有的 Chrome/Edge 浏览器，反检测能力更强)
ENABLE_CDP_MODE=true

# CDP 调试端口
CDP_DEBUG_PORT=9222

# 自定义浏览器可执行文件路径 (留空自动检测)
CUSTOM_BROWSER_PATH=""

# CDP 模式下是否启用无头模式
CDP_HEADLESS=false

# 浏览器启动超时 (秒)
BROWSER_LAUNCH_TIMEOUT=60

# 程序结束时是否自动关闭浏览器
AUTO_CLOSE_BROWSER=true

# 浏览器用户数据目录 (%s 会被替换为平台名)
USER_DATA_DIR="%s_user_data_dir"

# ==================== 数据存储 ====================

# 数据持久化方式: csv | json | excel | sqlite | db (MySQL) | postgres
# 选择 sqlite/db/postgres 时，WebUI 和命令行均会自动创建所需的数据库表
# 推荐使用 sqlite 或 db，有数据去重功能
SAVE_DATA_OPTION="csv"

# ---- SQLite (SAVE_DATA_OPTION=sqlite 时自动使用) ----
# 数据库文件路径: database/sqlite_tables.db (项目内置，无需额外配置)

# ---- MySQL (SAVE_DATA_OPTION=db 时使用) ----
MYSQL_DB_HOST="localhost"
MYSQL_DB_PORT=3306
MYSQL_DB_USER="root"
MYSQL_DB_PWD="123456"
MYSQL_DB_NAME="media_crawler"

# ---- PostgreSQL (SAVE_DATA_OPTION=postgres 时使用) ----
POSTGRES_DB_HOST="localhost"
POSTGRES_DB_PORT=5432
POSTGRES_DB_USER="postgres"
POSTGRES_DB_PWD="123456"
POSTGRES_DB_NAME="media_crawler"

# ---- Redis (缓存使用) ----
REDIS_DB_HOST="127.0.0.1"
REDIS_DB_PORT=6379
REDIS_DB_PWD="123456"
REDIS_DB_NUM=0

# ---- MongoDB (可选) ----
# MONGODB_HOST="localhost"
# MONGODB_PORT=27017
# MONGODB_USER=""
# MONGODB_PWD=""
# MONGODB_DB_NAME="media_crawler"

# ==================== 飞书同步配置 ====================

# 飞书开放平台应用凭证 (从 https://open.feishu.cn 获取)
FEISHU_APP_ID=""
FEISHU_APP_SECRET=""

# 飞书多维表格 App Token (从多维表格 URL 中获取)
FEISHU_BITABLE_APP_TOKEN=""

# 历史兼容键（建议改用 FEISHU_BITABLE_APP_TOKEN）
# FEISHU_APP_TOKEN=""

# 数据表 ID (可选，不填会自动创建)
FEISHU_TABLE_ID=""

# 批量写入条数 (默认 500，根据飞书 API 限制调整)
FEISHU_BATCH_SIZE=50

# 微信“全文内容”最大长度（0 表示不截断）
MAX_CONTENT_LENGTH=0

# ==================== 微信采集配置 ====================

# wechat-article-exporter 服务地址
WECHAT_API_BASE_URL=""

# 微信 API 认证密钥 (有效期约 4 天，需定期更换)
WECHAT_AUTH_KEY=""

# 微信扩展场景 secret（预留，当前可留空）
WECHAT_APP_SECRET=""

# 外部创作者列表 JSON 文件路径
WECHAT_CREATOR_LIST_FILE=""

# 请求失败重试配置
WECHAT_MAX_RETRY_COUNT=3
WECHAT_RETRY_BASE_DELAY_SEC=2

# 每个公众号最大文章数（0 表示不限制）
WECHAT_MAX_ARTICLES_PER_CREATOR=10

# 请求间隔（秒）
WECHAT_REQUEST_INTERVAL_SEC=3

# 文章日期范围筛选 (YYYY-MM-DD，不填则不限制)
WECHAT_ARTICLE_DATE_START=""
WECHAT_ARTICLE_DATE_END=""

# 爬取标签（写入 source_keyword）
WECHAT_CRAWL_TAG=""

# 是否跳过付费订阅文章
WECHAT_SKIP_PAYWALL_ARTICLES=true

# 文章下载格式: html | markdown | text | json
WECHAT_DOWNLOAD_FORMAT="markdown"

# 是否下载图片
WECHAT_DOWNLOAD_IMAGES=true

# 允许下载的图片格式 (逗号分隔)
WECHAT_ALLOWED_IMAGE_FORMATS="jpg,jpeg,png"

# 图片下载并发
WECHAT_IMAGE_DOWNLOAD_CONCURRENCY=3

# 资源保存目录（相对于 data/）
WECHAT_IMAGE_SAVE_DIR="wechat/images"
WECHAT_CONTENT_SAVE_DIR="wechat/articles"

# ==================== 平台 Cookie ====================
# 使用 cookie 登录模式 (LOGIN_TYPE=cookie) 时填写对应平台的 Cookie
# 可通过浏览器开发者工具获取，或通过 WebUI「平台 Cookie」配置组设置

# XHS_COOKIES=""
# DY_COOKIES=""
# BILI_COOKIES=""
# WB_COOKIES=""
# KS_COOKIES=""
# TIEBA_COOKIES=""
# ZHIHU_COOKIES=""

# ==================== 词云配置 ====================

# 是否生成词云
ENABLE_GET_WORDCLOUD=false

# 停用词文件路径
STOP_WORDS_FILE="./docs/hit_stopwords.txt"

# 中文字体文件路径
FONT_PATH="./docs/STZHONGS.TTF"
